# ── VEYRA configuration ─────────────────────────────────────
# No local model required. VEYRA uses a free OpenAI-compatible
# cloud endpoint by default (same approach as SAM's free-brain mode).

# Provider: "groq" | "cerebras" | "mistral" | "openai-compat" | "ollama"
VEYRA_PROVIDER=groq

# --- Groq (free tier, fast, recommended default) ---
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Cerebras (free tier, very fast) ---
# Get a key: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# --- Mistral (free tier) ---
# Get a key: https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Generic OpenAI-compatible endpoint (any provider) ---
# Set VEYRA_PROVIDER=openai-compat and fill these in.
OPENAI_COMPAT_URL=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=

# --- Optional: local Ollama (only if you have it installed) ---
# Leave VEYRA_PROVIDER=groq to ignore this entirely.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Engagement storage ──────────────────────────────────────
VEYRA_ENGAGEMENTS_DIR=./engagements

# ── Agent loop ──────────────────────────────────────────────
VEYRA_MAX_STEPS=8
